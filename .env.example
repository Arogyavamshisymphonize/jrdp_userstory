# Copy to .env and fill in. Never commit .env. On Render these are set by render.yaml / the dashboard instead.
APP_ENV=production
# Supabase > Project Settings > Database > Connection string > Session pooler (port 5432, IPv4).
# Not the transaction pooler (6543): it breaks prepared statements.
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Generate with: python -m src.manage gen-kek   (rotate: prepend a new id:key, deploy, run `manage rewrap`)
KEKS=k1:REPLACE_WITH_BASE64_32_BYTE_KEY
# Sign-in through Supabase Auth: the API verifies its tokens (all three values are public)
AUTH_MODE=oidc
OIDC_ISSUER=https://<project-ref>.supabase.co/auth/v1
OIDC_AUDIENCE=authenticated
OIDC_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# Admins: comma-separated Supabase user UIDs (Authentication > Users)
# ADMIN_USERS=
LOG_LEVEL=INFO
WEB_CONCURRENCY=2
# UI build settings (public; baked into the React bundle). dev = type any user id, needs AUTH_MODE=dev.
VITE_AUTH_MODE=supabase
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# Project Settings > API: the anon / publishable key. Never the service_role key.
VITE_SUPABASE_ANON_KEY=
# Optional tuning
# DB_POOL_SIZE=5
# THREADPOOL_SIZE=100
# KEY_SAVES_PER_MINUTE=10
# EXECUTIONS_PER_MINUTE=30
